# Astoria Elite Estates — Environment Configuration

# Required
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MONGODB_URI=mongodb://localhost:27017/astoria_elite

# Server
PORT=5000
NODE_ENV=development

# Development (Vite on :3000, API on :5000)
CORS_ORIGIN=http://localhost:3000

# Production / Staging — serve built frontend from Express
# SERVE_STATIC=true

# Demo seed ONLY — never set in production
# DEMO_SEED=true

# Demo credentials (after npm run seed):
# Username: admin@astoria.local
