# Astoria Elite Estates — Environment Configuration
# Copy values into the hosting panel (Parspack) or into server/.env for local use.
# Never commit real secrets.

# ── Required (always) ──────────────────────────
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MONGODB_URI=mongodb://localhost:27017/astoria_elite

# ── Server ─────────────────────────────────────
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Development (Vite on :3000, API on :5000)
CORS_ORIGIN=http://localhost:3000

# Production single-process mode is forced by `npm start` / start-prod.js
# SERVE_STATIC=true

# Public site origin for canonical URLs, sitemap, Open Graph (no trailing slash)
# SITE_ORIGIN=https://your-domain.example

# ── NEVER enable in production ─────────────────
# DEMO_SEED=true

# Demo credentials (after local `npm run seed` only):
# Username: admin@astoria.local
# Password: AstoriaDemo2026!
