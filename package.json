{
  "name": "estate-pro1",
  "version": "1.0.0",
  "description": "ASTORIA ELITE ESTATES - Luxury Real Estate Website",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "npm run install:server",
    "install:server": "npm install --prefix server --no-fund --no-audit",
    "install:all": "npm install --ignore-scripts && npm run install:server",
    "server": "npm run start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "server:prod": "npm run start:prod --prefix server",
    "prestart": "node server/check-deps.js",
    "start": "node server/start-prod.js",
    "start:prod": "node server/start-prod.js",
    "seed": "npm run seed --prefix server",
    "qa:staging": "node scripts/staging-smoke-qa.mjs",
    "qa:production": "node scripts/production-smoke-qa.mjs",
    "qa:seo": "node scripts/seo-smoke-qa.mjs"
  },
  "devDependencies": {},
  "author": "Astoria Dev Team",
  "license": "UNLICENSED",
  "dependencies": {
    "lucide": "^1.27.0",
    "sass": "^1.102.0",
    "vite": "^5.4.21"
  }
